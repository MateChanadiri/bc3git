# Matches the indentation the tree already uses. Xcode-managed files
# (project.pbxproj, plists, entitlements) use tabs and are left to Xcode.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.swift]
indent_style = space
indent_size = 4

[*.{c,cc,cpp,h}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.{json,xctestplan,xcstrings,yml,yaml}]
indent_style = space
indent_size = 2

[*.{pbxproj,plist,entitlements}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# Generated by scripts/convert-strings.py.
[App/BitChord/Support/L10n.swift]
trim_trailing_whitespace = false

# Recorded responses and media must stay byte for byte as captured.
[**/Fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
