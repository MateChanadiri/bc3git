    "widget_pill_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel mit „Gefällt mir“, Zufallswiedergabe und Wiedergabesteuerung in einer Zeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The track with Like, Shuffle and playback controls, in a single row."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pista con Me gusta, orden aleatorio y controles de reproducción en una sola fila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le titre avec J'aime, lecture aléatoire et commandes de lecture, sur une seule ligne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הרצועה עם לייק, ערבוב ופקדי הפעלה, בשורה אחת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रैक के साथ लाइक, शफ़ल और प्लेबैक नियंत्रण, एक ही पंक्ति में।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagu dengan Suka, Acak, dan kontrol pemutaran dalam satu baris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il brano con Mi piace, Casuale e controlli di riproduzione, su una sola riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲名といいね、シャッフル、再生コントロールを1行に。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwór z polubieniem, losowaniem i kontrolkami odtwarzania w jednym wierszu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A faixa com Curtir, ordem aleatória e controles de reprodução em uma única linha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трек с лайком, перемешиванием и управлением воспроизведением в одну строку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพลงพร้อมปุ่มถูกใจ สุ่มเล่น และปุ่มควบคุมการเล่นในแถวเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beğen, karışık çalma ve çalma kontrolleriyle parça, tek satırda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản nhạc kèm Thích, trộn bài và điều khiển phát trên một hàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
