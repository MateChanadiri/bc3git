    "high_performance_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet vollständige Animationen und Unschärfe und fordert eine höhere Bildwiederholrate an"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses full animations and blur, and requests a higher display refresh rate"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa las animaciones y el desenfoque completos, y solicita una frecuencia de pantalla más alta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise toutes les animations et le flou, et demande un taux de rafraîchissement plus élevé"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משתמש באנימציות מלאות וטשטוש, ומבקש קצב רענון מסך גבוה יותר"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे एनिमेशन और ब्लर का उपयोग करता है, और डिस्प्ले का ज़्यादा रिफ़्रेश रेट मांगता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan animasi dan blur penuh, serta meminta refresh rate layar yang lebih tinggi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa animazioni e sfocatura complete e richiede una frequenza di aggiornamento più alta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルアニメーションとぼかしを使用し、より高いディスプレイリフレッシュレートをリクエストします"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa pełnych animacji i rozmycia oraz żąda wyższej częstotliwości odświeżania ekranu"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa animações completas e desfoque, e solicita uma taxa de atualização de tela mais alta"
