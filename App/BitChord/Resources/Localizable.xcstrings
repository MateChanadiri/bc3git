          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उच्च प्रदर्शन तेजी से विश्लेषण करता है लेकिन अधिक बैटरी की खपत करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performa lebih tinggi menganalisis lebih cepat tetapi menggunakan lebih banyak baterai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prestazioni più elevate analizzano i brani più velocemente, ma possono usare più batteria e scaldare il telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高いパフォーマンスを設定すると分析が速くなりますが、バッテリーを多く消費し端末が温かくなる可能性があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyższa wydajność szybciej analizuje utwory, ale zużywa więcej baterii."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maior desempenho analisa mais rápido, mas gasta mais bateria e aquece o dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высокая производительность быстрее анализирует треки, но сильнее садит батарею."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ประสิทธิภาพที่สูงขึ้นจะวิเคราะห์แทร็กได้เร็วขึ้น แต่อาจใช้แบตเตอรี่มากขึ้นและทำให้เครื่องร้อนขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yüksek performans, parçaları daha hızlı analiz eder ancak daha fazla pil kullanabilir ve telefonu ısıtabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiệu năng cao hơn phân tích nhanh hơn, nhưng có thể tốn pin hơn và làm máy ấm lên."
