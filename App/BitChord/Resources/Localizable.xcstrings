    "loudness_target_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiser passt zu Kopfhörern, lauter zum Auto oder Handylautsprecher"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quieter suits headphones; louder suits a car or a phone speaker"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más bajo va mejor con auriculares; más alto, en el coche o el altavoz del teléfono"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus bas pour un casque ; plus fort pour la voiture ou le haut-parleur du téléphone"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שקט יותר מתאים לאוזניות; חזק יותר לרכב או לרמקול הטלפון"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम हेडफ़ोन के लिए ठीक है; ज़्यादा कार या फ़ोन स्पीकर के लिए"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih pelan cocok untuk headphone; lebih keras cocok untuk mobil atau speaker ponsel"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più bassa per le cuffie; più alta per l'auto o l'altoparlante del telefono"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さめはヘッドホン向け、大きめは車やスマホのスピーカー向けです"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciszej pasuje do słuchawek; głośniej do samochodu lub głośnika telefonu"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais baixo combina com fones; mais alto, com o carro ou o alto-falante do celular"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тише — для наушников; громче — для машины или динамика телефона"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เบาลงเหมาะกับหูฟัง ดังขึ้นเหมาะกับในรถหรือลำโพงโทรศัพท์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha düşük kulaklığa, daha yüksek araba veya telefon hoparlörüne uygundur"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhỏ hơn hợp với tai nghe; lớn hơn hợp với ô tô hoặc loa điện thoại"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较低适合耳机；较高适合车载或手机扬声器"
          }
        }
      }
    },
