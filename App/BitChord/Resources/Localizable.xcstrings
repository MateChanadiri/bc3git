    "equalizer_bitstream_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Equalizer arbeitet mit dekodiertem Audio. Dieser Titel wird als Bitstream durchgereicht, den dein Gerät selbst dekodiert – hier gibt es also keine Samples zum Filtern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The equaliser works on decoded audio. This track is passed through as a bitstream for your device to decode, so there are no samples here to filter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ecualizador trabaja con audio decodificado. Esta pista pasa como bitstream para que tu dispositivo la decodifique, así que aquí no hay muestras que filtrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'égaliseur travaille sur de l'audio décodé. Ce titre est transmis en bitstream pour que ton appareil le décode, il n'y a donc aucun échantillon à filtrer ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האקולייזר פועל על אודיו מפוענח. הרצועה הזו מועברת כ-bitstream שהמכשיר שלכם מפענח בעצמו, כך שאין כאן דגימות לסנן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इक्वलाइज़र डीकोड किए गए ऑडियो पर काम करता है। यह ट्रैक बिटस्ट्रीम के रूप में आपके डिवाइस को डीकोड करने के लिए भेजा जाता है, इसलिए यहाँ फ़िल्टर करने के लिए कोई सैंपल नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equalizer bekerja pada audio yang sudah didekode. Lagu ini diteruskan sebagai bitstream untuk didekode oleh perangkatmu, jadi tidak ada sampel yang bisa difilter di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'equalizzatore lavora sull'audio decodificato. Questo brano passa come bitstream che il tuo dispositivo decodifica da solo, quindi qui non ci sono campioni da filtrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イコライザーはデコード済みの音声に作用します。この曲はデバイス側でデコードするビットストリームとしてそのまま渡されるため、ここには処理できるサンプルがありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korektor działa na zdekodowanym dźwięku. Ten utwór jest przekazywany jako bitstream do zdekodowania przez twoje urządzenie, więc nie ma tu próbek do filtrowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O equalizador trabalha com áudio decodificado. Esta faixa passa como bitstream para o seu dispositivo decodificar, então não há amostras aqui para filtrar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эквалайзер работает с декодированным звуком. Этот трек передаётся битстримом, и декодирует его ваше устройство, поэтому здесь нет сэмплов для обработки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อีควอไลเซอร์ทำงานกับเสียงที่ถอดรหัสแล้ว แทร็กนี้ถูกส่งผ่านเป็นบิตสตรีมให้อุปกรณ์ของคุณถอดรหัสเอง จึงไม่มีตัวอย่างเสียงให้กรองที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekolayzer çözülmüş ses üzerinde çalışır. Bu parça, cihazının çözmesi için bitstream olarak aktarılıyor; bu yüzden burada filtrelenecek örnek yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ chỉnh âm chỉ hoạt động trên âm thanh đã giải mã. Bản nhạc này được truyền thẳng dưới dạng bitstream để thiết bị của bạn tự giải mã, nên ở đây không có mẫu âm thanh nào để lọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "均衡器作用于解码后的音频。此曲目以比特流形式直通，由你的设备解码，因此这里没有可供处理的采样。"
          }
        }
      }
    },
