    "song_cache_limit_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält heruntergeladenes Audio auf dem Speicher für sofortiges Springen und Wiederholen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
