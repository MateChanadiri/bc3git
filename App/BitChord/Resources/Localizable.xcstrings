    "high_performance_active" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Hz angefordert. Android kann die Rate bei Bedarf verringern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Hz requested. Android may lower it when needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se solicitaron %1$lld Hz. Android puede reducirlos cuando sea necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Hz demandés. Android peut le réduire si nécessaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld הרץ התבקש. מערכת אנדרואיד עשויה להפחית זאת במידת הצורך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Hz का अनुरोध किया गया। ज़रूरत पड़ने पर Android इसे कम कर सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Hz diminta. Android dapat menurunkannya saat diperlukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Hz richiesti. Android potrebbe ridurli quando necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Hzをリクエスト中です。必要に応じてAndroidが下げることがあります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zażądano %1$lld Hz. Android może ją obniżyć, jeśli to konieczne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Hz solicitados. O Android pode diminuir quando necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрошена частота %1$lld Гц. Android может снизить её при необходимости."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขออัตรารีเฟรช %1$lld Hz ระบบ Android อาจลดลงเมื่อจำเป็น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Hz istendi. Android gerektiğinde bunu düşürebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã yêu cầu %1$lld Hz. Android có thể giảm tần số khi cần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
