          "stringUnit" : {
            "state" : "translated",
            "value" : "डाउनलोड केवल Wi-Fi तक सीमित हैं। मोबाइल डेटा इस्तेमाल करने के लिए सेटिंग्स में इसे बंद करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unduhan dibatasi hanya lewat Wi-Fi. Nonaktifkan itu di Pengaturan untuk menggunakan data seluler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I download sono limitati al Wi-Fi. Disattivalo nelle Impostazioni per usare i dati mobili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードはWi-Fiのみに制限されています。モバイルデータを使うには設定でオフにしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobieranie jest ograniczone do Wi-Fi. Wyłącz to w Ustawieniach, aby korzystać z danych komórkowych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads são limitados ao Wi-Fi. Desligue isso nas Configurações para usar dados móveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загрузки ограничены сетью Wi-Fi. Отключите это в настройках, чтобы использовать мобильные данные."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดาวน์โหลดจำกัดไว้เฉพาะ Wi-Fi ปิดการตั้งค่านี้เพื่อใช้เน็ตมือถือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirmeler yalnızca Wi-Fi ile sınırlıdır. Mobil veri kullanmak için Ayarlar'dan bunu kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tải xuống đang bị giới hạn chỉ qua Wi-Fi. Hãy tắt tùy chọn đó trong Cài đặt để sử dụng dữ liệu di động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载已限制为仅使用 Wi-Fi。请在设置中关闭此项以使用移动数据。"
          }
        }
      }
    },
