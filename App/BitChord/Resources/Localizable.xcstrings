    "listen_together_official_server_dialog_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Party läuft auf dem offiziellen BitChord-Server.\n\nMöchtest du zurück zum offiziellen Server wechseln und der Party %1$@ beitreten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This party is hosted on the official BitChord server.\n\nDo you want to switch back to the official server and join party %1$@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta fiesta está alojada en el servidor oficial de BitChord.\n\n¿Quieres volver al servidor oficial y unirte a la fiesta %1$@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session est hébergée sur le serveur officiel de BitChord.\n\nVeux-tu revenir au serveur officiel et rejoindre la session %1$@ ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המסיבה הזו מתארחת בשרת הרשמי של BitChord.\n\nלחזור לשרת הרשמי ולהצטרף למסיבה %1$@?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पार्टी BitChord के आधिकारिक सर्वर पर चल रही है।\n\nक्या आप आधिकारिक सर्वर पर लौटकर पार्टी %1$@ में शामिल होना चाहते हैं?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesta ini di-host di server resmi BitChord.\n\nMau kembali ke server resmi dan ikut pesta %1$@?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo party è ospitato sul server ufficiale di BitChord.\n\nVuoi tornare al server ufficiale ed entrare nel party %1$@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパーティーはBitChord公式サーバーでホストされています。\n\n公式サーバーに戻して、パーティー %1$@ に参加しますか？"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta impreza działa na oficjalnym serwerze BitChord.\n\nCzy chcesz wrócić na oficjalny serwer i dołączyć do imprezy %1$@?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta festa está hospedada no servidor oficial do BitChord.\n\nQuer voltar ao servidor oficial e entrar na festa %1$@?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта вечеринка размещена на официальном сервере BitChord.\n\nВернуться на официальный сервер и присоединиться к вечеринке %1$@?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปาร์ตี้นี้โฮสต์อยู่บนเซิร์ฟเวอร์ทางการของ BitChord\n\nต้องการกลับไปใช้เซิร์ฟเวอร์ทางการและเข้าร่วมปาร์ตี้ %1$@ หรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu parti resmi BitChord sunucusunda barındırılıyor.\n\nResmi sunucuya geri dönüp %1$@ partisine katılmak istiyor musun?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This party is hosted on the official BitChord server.\n\nDo you want to switch back to the official server and join party %1$@?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此派对托管在 BitChord 官方服务器上。\n\n要切换回官方服务器并加入派对 %1$@ 吗？"
          }
        }
      }
    },
