    "automix_performance_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Leistung analysiert schneller, verbraucht aber mehr Akku."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher performance analyses tracks faster, but can use more battery and make the phone warmer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rendimiento alto analiza más rápido, pero puede consumir más batería y calentar el teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une performance plus élevée analyse plus vite mais utilise plus de batterie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
