    "listen_together_code_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies ihn vor oder schick ihn. O und I kommen nicht vor, ein „O“ ist also immer eine Null."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read it out or send it. O and I aren’t used, so an “oh” is always a zero."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dilo en voz alta o envíalo. La O y la I no se usan, así que una «o» siempre es un cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lis-le à voix haute ou envoie-le. Les lettres O et I ne sont pas utilisées, un « o » est donc toujours un zéro."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקריאו אותו או שלחו אותו. האותיות O ו-I אינן בשימוש, ולכן O היא תמיד אפס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे बोलकर बताएँ या भेज दें। O और I इस्तेमाल नहीं होते, इसलिए “ओ” हमेशा शून्य है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bacakan atau kirimkan. Huruf O dan I tidak dipakai, jadi “o” selalu berarti nol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggilo ad alta voce o invialo. O e I non vengono usate, quindi una «o» è sempre uno zero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み上げるか送ってください。O と I は使われないので、「オー」は必ずゼロです。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeczytaj go na głos albo wyślij. Liter O i I nie używamy, więc „o” to zawsze zero."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia em voz alta ou envie. O e I não são usados, então um “ó” é sempre zero."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продиктуйте или отправьте его. Буквы O и I не используются, поэтому «о» — это всегда ноль."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านออกเสียงหรือส่งให้ก็ได้ ไม่ใช้ตัว O และ I ดังนั้น “โอ” คือเลขศูนย์เสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek sesle oku ya da gönder. O ve I harfleri kullanılmaz, yani bir “o” her zaman sıfırdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read it out or send it. O and I aren’t used, so an “oh” is always a zero."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读出来或发出去。字母 O 和 I 不会用到，所以“欧”永远是零。"
          }
        }
      }
