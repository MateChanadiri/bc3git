    "listen_together_custom_server_dialog_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Party läuft auf einem externen Server:\n\n%1$@\n\nMöchtest du deinen Party-Server wechseln und der Party %2$@ beitreten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This party is hosted on an external server:\n\n%1$@\n\nDo you want to switch your party server and join party %2$@?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta fiesta está alojada en un servidor externo:\n\n%1$@\n\n¿Quieres cambiar tu servidor de fiestas y unirte a la fiesta %2$@?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette session est hébergée sur un serveur externe :\n\n%1$@\n\nVeux-tu changer de serveur de session et rejoindre la session %2$@ ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המסיבה הזו מתארחת בשרת חיצוני:\n\n%1$@\n\nלהחליף את שרת המסיבות ולהצטרף למסיבה %2$@?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पार्टी एक बाहरी सर्वर पर चल रही है:\n\n%1$@\n\nक्या आप अपना पार्टी सर्वर बदलकर पार्टी %2$@ में शामिल होना चाहते हैं?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesta ini di-host di server eksternal:\n\n%1$@\n\nMau mengganti server pesta dan ikut pesta %2$@?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo party è ospitato su un server esterno:\n\n%1$@\n\nVuoi cambiare server dei party ed entrare nel party %2$@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパーティーは外部サーバーでホストされています:\n\n%1$@\n\nパーティーサーバーを切り替えて、パーティー %2$@ に参加しますか？"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta impreza działa na zewnętrznym serwerze:\n\n%1$@\n\nCzy chcesz zmienić serwer imprez i dołączyć do imprezy %2$@?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta festa está hospedada em um servidor externo:\n\n%1$@\n\nQuer trocar seu servidor de festas e entrar na festa %2$@?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта вечеринка размещена на внешнем сервере:\n\n%1$@\n\nСменить сервер вечеринок и присоединиться к вечеринке %2$@?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปาร์ตี้นี้โฮสต์อยู่บนเซิร์ฟเวอร์ภายนอก:\n\n%1$@\n\nต้องการเปลี่ยนเซิร์ฟเวอร์ปาร์ตี้และเข้าร่วมปาร์ตี้ %2$@ หรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu parti harici bir sunucuda barındırılıyor:\n\n%1$@\n\nParti sunucunu değiştirip %2$@ partisine katılmak istiyor musun?"
          }
        },
        "vi" : {
