    "song_cache_large_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält bis zu %1$@ heruntergeladenes Audio auf dem Speicher. Das kann einen spürbaren Teil deines freien Speicherplatzes beanspruchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps up to %1$@ of downloaded audio on disk. This can take a noticeable share of your free space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva hasta %1$@ de audio descargado en el dispositivo. Puede ocupar una parte importante del espacio libre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserve jusqu'à %1$@ d'audio téléchargé sur le disque. Cela peut occuper une part importante de votre espace libre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שומר עד %1$@ של שמע שהורד בכונן. זה יכול לתפוס נתח משמעותי מהמקום הפנוי שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क पर %1$@ तक डाउनलोड किया गया ऑडियो रखता है। इससे आपकी खाली जगह का एक बड़ा हिस्सा इस्तेमाल हो सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyimpan hingga %1$@ audio yang diunduh di disk. Ini dapat memakan porsi ruang kosong yang cukup besar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene fino a %1$@ di audio scaricato sul disco. Questo può occupare una quota significativa dello spazio libero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした音声を最大%1$@までディスクに保持します。空き容量をかなり使用することがあります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowuje maksymalnie %1$@ pobranego dźwięku na dysku. To może zająć znaczną część wolnego miejsca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém até %1$@ de áudio em disco. Isso pode usar bastante espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранит на диске до %1$@ загруженного аудио. Это может занять заметную часть свободного места."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บเสียงที่ดาวน์โหลดไว้บนดิสก์สูงสุด %1$@ ซึ่งอาจใช้พื้นที่ว่างของคุณไปมาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskte %1$@'a kadar indirilen sesi tutar. Bu, boş alanının önemli bir kısmını kaplayabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu tối đa %1$@ âm thanh đã tải trên ổ đĩa. Tùy chọn này có thể chiếm dung lượng đáng kể trong bộ nhớ trống của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多在磁盘上保留 %1$@ 的已下载音频，这可能会占用较多可用空间。"
          }
        }
      }
    },
