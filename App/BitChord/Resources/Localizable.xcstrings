    "account_profiles_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Google-Konto kann persönliche und Markenprofile haben, jeweils mit eigener Mediathek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Google account can have Personal and Brand profiles. Each has its own library, likes and history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cuenta de Google puede tener perfiles Personal y de marca. Cada uno tiene su propia biblioteca, Me gusta e historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte Google peut avoir des profils personnel et de marque, chacun avec sa bibliothèque et son historique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחשבון Google יכולים להיות פרופילים אישיים ועסקיים, לכל אחד ספרייה והיסטוריה משלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google खाते में व्यक्तिगत और ब्रांड प्रोफ़ाइल हो सकती हैं। प्रत्येक की अपनी लाइब्रेरी और इतिहास होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun Google dapat memiliki profil Pribadi dan Merek. Masing-masing memiliki perpustakaan dan histori sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un account Google può avere profili Personale e Brand. Ciascuno ha la propria libreria, i propri Mi piace e la propria cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google アカウントには個人プロフィールとブランド プロフィールがあります。それぞれにライブラリ、高評価、再生履歴があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto Google może mieć profile osobiste i marki, każdy z własną biblioteką i historią."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma conta do Google pode ter perfis Pessoal e de Marca. Cada um tem sua própria biblioteca e curtidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У аккаунта Google могут быть личный и брендовый профили. У каждого своя медиатека и история."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัญชี Google หนึ่งบัญชีสามารถมีโปรไฟล์ส่วนตัวและโปรไฟล์แบรนด์ได้ แต่ละโปรไฟล์มีคลังเพลง เพลงที่ถูกใจ และประวัติของตัวเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Google hesabının Kişisel ve Marka profilleri olabilir. Her birinin kendi kitaplığı, beğenileri ve geçmişi vardır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một tài khoản Google có thể có hồ sơ Cá nhân và Thương hiệu. Mỗi hồ sơ có thư viện, lượt thích và lịch sử riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 账号可以拥有个人和品牌资料。每个资料都有自己的媒体库、顶和历史记录。"
          }
        }
      }
    },
