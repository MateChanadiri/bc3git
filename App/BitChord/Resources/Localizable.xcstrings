    "hide_song_status_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet den Text „Wiedergabe aus“ bzw. „Abgespielt von“ im Player aus"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hides the “Playing from” or “Played by” text in the main player"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta el texto «Reproduciendo desde» o «Reproducido por» en el reproductor principal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masque le texte « Lecture depuis » ou « Lu par » dans le lecteur principal"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסתיר את הטקסט „מושמע מתוך” או „הושמע על ידי” בנגן הראשי"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुख्य प्लेयर में “यहाँ से चल रहा है” या “इन्होंने चलाया” टेक्स्ट छिपाता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyembunyikan teks “Diputar dari” atau “Diputar oleh” di pemutar utama"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasconde il testo «In riproduzione da» o «Riprodotto da» nel player principale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインプレーヤーの「再生元」や「再生者」の表示を隠します"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukrywa tekst „Odtwarzane z” lub „Odtwarzane przez” w głównym odtwarzaczu"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta o texto “Tocando de” ou “Tocado por” no player principal"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает текст «Играет из» или «Воспроизводит» в основном плеере"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ซ่อนข้อความ “กำลังเล่นจาก” หรือ “เล่นโดย” ในเพลเยอร์หลัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana oynatıcıdaki “Şuradan çalınıyor” veya “Çalan” yazısını gizler"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn dòng “Phát từ” hoặc “Được phát bởi” trong trình phát chính"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏主播放器中的“播放自”或“播放者”文字"
          }
        }
      }
    },
