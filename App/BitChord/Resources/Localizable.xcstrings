    "listen_together_host_only_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle anderen hören mit und können auf ihrem eigenen Gerät pausieren"
          }
