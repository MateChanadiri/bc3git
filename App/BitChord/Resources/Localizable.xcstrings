    "addon_url_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge die URL des Add-ons ein — Stammverzeichnis oder manifest.json."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste the addon’s URL — either its root or its manifest.json. BitChord reads what it can search and stream, then asks it for tracks over plain HTTP."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega la URL del complemento, ya sea la raíz o manifest.json. BitChord leerá qué puede buscar y reproducir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez l'URL de l'extension — racine ou manifest.json. BitChord lira ce qu'il peut rechercher et diffuser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדבק את כתובת ה-URL של התוסף — תיקיית שורש או manifest.json."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एडऑन का URL पेस्ट करें — रूट या manifest.json।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempel URL addon — direktori utama atau manifest.json."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla l'URL del componente aggiuntivo — radice o manifest.json. BitChord leggerà i contenuti disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドオンの URL（ルートまたは manifest.json）を貼り付けます。BitChord が検索および再生できる曲を読み取ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklej adres URL wtyczki — katalog główny lub manifest.json."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cole a URL da extensão — raiz ou manifest.json. O BitChord lerá os conteúdos disponíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вставьте URL плагина — корень или manifest.json. BitChord считает доступные треки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste the addon’s URL — either its root or its manifest.json. BitChord reads what it can search and stream, then asks it for tracks over plain HTTP."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eklentinin URL'sini yapıştırın — kök dizin veya manifest.json. BitChord arama ve oynatma yeteneklerini okur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán URL của tiện ích mở rộng — đường dẫn gốc hoặc manifest.json. BitChord sẽ đọc các mục có thể tìm kiếm và phát, sau đó yêu cầu bản nhạc qua giao thức HTTP tiêu chuẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴插件网址 — 根目录或 manifest.json 均可。BitChord 会读取其搜索和流式播放内容，并通过标准 HTTP 请求曲目。"
          }
        }
      }
    },
