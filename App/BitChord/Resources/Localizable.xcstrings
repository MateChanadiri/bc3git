    "listen_together_create_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst einen sechsstelligen Code. Jeder, der ihn hat, kann beitreten – bis zu %1$lld Geräte, dein eigenes eingeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You get a six-character code. Anyone who has it can join, up to %1$lld devices including yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibes un código de seis caracteres. Cualquiera que lo tenga puede unirse, hasta %1$lld dispositivos incluido el tuyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu reçois un code de six caractères. Quiconque l’a peut rejoindre, jusqu’à %1$lld appareils, le tien compris."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תקבלו קוד של שישה תווים. כל מי שיש לו אותו יכול להצטרף, עד %1$lld מכשירים כולל שלכם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको छह अक्षरों का कोड मिलेगा। जिसके पास यह है वह जुड़ सकता है — आपके साथ मिलाकर %1$lld डिवाइस तक।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu dapat kode enam karakter. Siapa pun yang punya kodenya bisa ikut, sampai %1$lld perangkat termasuk milikmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi un codice di sei caratteri. Chi lo ha può entrare, fino a %1$lld dispositivi compreso il tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6文字のコードが発行されます。コードを知っている人は誰でも参加でき、自分を含めて%1$lld台までです。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymasz sześcioznakowy kod. Każdy, kto go ma, może się dołączyć — do %1$lld urządzeń, licząc twoje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você recebe um código de seis caracteres. Qualquer pessoa com ele pode entrar, até %1$lld dispositivos incluindo o seu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы получите код из шести символов. Присоединиться может любой, у кого он есть, — до %1$lld устройств, включая ваше."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะได้รหัสหกตัวอักษร ใครที่มีรหัสก็เข้าร่วมได้ สูงสุด %1$lld เครื่องรวมเครื่องของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altı karakterlik bir kod alırsın. Koda sahip olan herkes katılabilir; seninle birlikte en fazla %1$lld cihaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ nhận được mã gồm sáu ký tự. Ai có mã đều có thể tham gia, tối đa %1$lld thiết bị kể cả của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你会得到一个六位代码。拿到代码的人都能加入，包括你自己最多 %1$lld 台设备。"
          }
        }
      }
    },
