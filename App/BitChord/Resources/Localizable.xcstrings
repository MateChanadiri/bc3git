    "listen_together_custom_server_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, um den eingebauten Server zu nutzen. Wenn du eine eigene Kopie betreibst, müssen alle in der Party auf denselben Server zeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave this empty to use the default server. If you run your own copy, everyone in the party has to be pointed at the same one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo vacío para usar el servidor integrado. Si tienes tu propia copia, todos en la fiesta deben apuntar al mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse ce champ vide pour utiliser le serveur intégré. Si tu héberges ta propre copie, tout le monde dans la session doit pointer vers le même."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השאירו ריק כדי להשתמש בשרת המובנה. אם אתם מריצים עותק משלכם, כל מי שבמסיבה צריך להפנות לאותו שרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिल्ट-इन सर्वर इस्तेमाल करने के लिए इसे खाली छोड़ दें। अगर आप अपनी कॉपी चलाते हैं, तो पार्टी में सबको वही सर्वर देना होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan kosong untuk memakai server bawaan. Kalau kamu menjalankan salinan sendiri, semua orang di pesta harus diarahkan ke server yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto per usare il server integrato. Se ne gestisci una copia tua, tutti nel party devono puntare alla stessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空のままにすると内蔵サーバーを使います。自分でコピーを動かしている場合は、パーティーの全員が同じサーバーを指している必要があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostaw puste, aby użyć wbudowanego serwera. Jeśli prowadzisz własną kopię, wszyscy w imprezie muszą wskazywać ten sam adres."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe vazio para usar o servidor integrado. Se você roda sua própria cópia, todos na festa precisam apontar para a mesma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте пустым, чтобы использовать встроенный сервер. Если у вас своя копия, все участники должны указать один и тот же адрес."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เว้นว่างไว้เพื่อใช้เซิร์ฟเวอร์ที่มีมาให้ ถ้าคุณรันสำเนาของตัวเอง ทุกคนในปาร์ตี้ต้องชี้ไปที่เซิร์ฟเวอร์เดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerleşik sunucuyu kullanmak için boş bırak. Kendi kopyanı çalıştırıyorsan partideki herkesin aynı adresi göstermesi gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để trống mục này để sử dụng máy chủ mặc định. Nếu bạn chạy bản sao riêng, mọi người trong nhóm phải trỏ đến cùng một máy chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空则使用内置服务器。如果你运行自己的副本，派对中的所有人都必须指向同一个。"
          }
        }
      }
    },
