    "listen_together_members_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Party hat Platz für %1$lld Geräte. Jeder darin kann die Musik steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A party holds %1$lld devices. Anyone in it can control the music."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fiesta admite %1$lld dispositivos. Cualquiera que esté en ella puede controlar la música."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une session accueille %1$lld appareils. Tous ceux qui y sont peuvent contrôler la musique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במסיבה יש מקום ל-%1$lld מכשירים. כל מי שנמצא בה יכול לשלוט במוזיקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पार्टी में %1$lld डिवाइस आते हैं। इसमें कोई भी म्यूज़िक कंट्रोल कर सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu pesta menampung %1$lld perangkat. Siapa pun di dalamnya bisa mengatur musik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un party ospita %1$lld dispositivi. Chiunque ci sia dentro può controllare la musica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パーティーには %1$lld 台まで入れます。参加者は誰でも音楽を操作できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impreza pomieści %1$lld urządzeń. Każdy w niej może sterować muzyką."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma festa cabe %1$lld dispositivos. Qualquer um nela pode controlar a música."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В вечеринке до %1$lld устройств. Управлять музыкой может любой участник."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปาร์ตี้รับได้ %1$lld เครื่อง ใครที่อยู่ในนั้นก็ควบคุมเพลงได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir parti %1$lld cihaz alır. İçindeki herkes müziği kontrol edebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A party holds %1$lld devices. Anyone in it can control the music."
          }
        },
        "zh-Hans" : {
